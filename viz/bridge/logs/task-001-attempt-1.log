+def draw_hud(image: Image.Image, t: float, theta: float) -> None:
+    draw = ImageDraw.Draw(image)
+    draw.text((sp(70), sp(25)), "court coverage — top view", font=TITLE_FONT, fill=DARK, anchor="la")
+
+    chip = (sp(672), sp(20), sp(906), sp(74))
